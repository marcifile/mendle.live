NODE_ENV=production

# Lovable Cloud / Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. If omitted, the engine requires exactly one row in project_config.
MENDLE_PROJECT_ID=

# Solana RPC. A Helius RPC URL works well here.
SOLANA_RPC_URL=

# Timing
MARKET_POLL_INTERVAL_MS=2000\nMARKET_SNAPSHOT_INTERVAL_SECONDS=10
GENERATION_INTERVAL_SECONDS=300
INITIAL_OBSERVATION_SECONDS=300
POPULATION_TARGET=128
GENERATIONS_PER_EPOCH=24

# Genetics
BASE_MUTATION_RATE=0.015
DISTURBANCE_MUTATION_BONUS=0.020
GENE_MUTATION_MAX_DELTA=8
MIN_SURVIVORS=40
MAX_SURVIVORS=100

# Scoring
BASELINE_WINDOW_MINUTES=60
DEPTH_VOLUME_MULTIPLIER=2
DISTURBANCE_SENSITIVITY=1.5

# Epoch legacy
LEGACY_EFFECT=0.03
LEGACY_MAX_EFFECT=0.05
LEGACY_DURATION_EPOCHS=2

# Logging
LOG_LEVEL=info
